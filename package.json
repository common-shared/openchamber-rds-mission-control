{
  "name": "openchamber-rds-mission-control",
  "version": "0.3.0",
  "description": "RDS Mission Control: Monitor, Configure, and Launch RDS sessions with UDIS, Steerable Autonomy, and Dynamic Ergonomics.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "openchamber-rds-mission-control": "./bin/mission-control.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/common-shared/openchamber-rds-mission-control.git"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.3.0"
    },
    "contributes": {
      "panel": {
        "id": "rds-mission-control",
        "name": "RDS Mission Control",
        "icon": "icon.svg"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "RDS Mission Control",
        "height": 175,
        "defaultExpanded": true,
        "requiresProject": true
      },
      "filesystem": [
        "~/.openchamber/**",
        "/tmp/opencode/**"
      ],
      "capabilities": [
        "files",
        "sessions",
        "prompt",
        "model"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "install:extension": "node scripts/installer.mjs install",
    "update:extension": "node scripts/installer.mjs update",
    "remove:extension": "node scripts/installer.mjs remove",
    "doctor": "node scripts/installer.mjs doctor",
    "verify:release": "node scripts/installer.mjs verify-release"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
